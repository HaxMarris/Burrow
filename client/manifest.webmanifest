{
  "id": "/",
  "name": "Peiskos",
  "short_name": "Peiskos",
  "description": "Chat, voice and the Campfire with your friends",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f0e7",
  "theme_color": "#c4561c",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "categories": [
    "social"
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/pdf",
            "application/zip",
            "*/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Direct messages",
      "short_name": "Messages",
      "url": "/?open=dms",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
