{
  "name": "burrow-chat",
  "productName": "Burrow",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for a self-hosted Burrow chat server",
  "author": "Burrow",
  "homepage": "https://github.com/HaxMarris/Burrow",
  "main": "main.js",
  "scripts": {
    "copy-client": "node scripts/copy-client.js",
    "start": "npm run copy-client && electron .",
    "dist": "npm run copy-client && electron-builder",
    "dist:win": "npm run copy-client && electron-builder --win",
    "dist:mac": "npm run copy-client && electron-builder --mac",
    "dist:linux": "npm run copy-client && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "chat.burrow.desktop",
    "productName": "Burrow",
    "files": [
      "main.js",
      "updater.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Burrow uses your microphone when you join a voice room."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Chat"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Burrow-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HaxMarris",
        "repo": "Burrow"
      }
    ]
  }
}
