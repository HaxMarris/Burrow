{
  "name": "burrow-chat",
  "productName": "Peiskos",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for Peiskos, a self-hosted place to chat, talk and hang out with friends",
  "author": "Peiskos",
  "homepage": "https://github.com/HaxMarris/Burrow",
  "main": "main.js",
  "scripts": {
    "copy-client": "node scripts/copy-client.js",
    "start": "npm run copy-client && electron .",
    "dist": "npm run copy-client && electron-builder",
    "dist:win": "npm run copy-client && electron-builder --win",
    "dist:mac": "npm run copy-client && electron-builder --mac",
    "dist:linux": "npm run copy-client && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "optionalDependencies": {
    "loopback-capture": "3.0.2",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "chat.burrow.desktop",
    "productName": "Peiskos",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app-audio.js",
      "hotkeys.js",
      "activity.js",
      "tray.js",
      "shortcuts.js",
      "draw-overlay.js",
      "draw-overlay-preload.js",
      "draw-overlay.html",
      "draw-overlay-page.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Peiskos-${version}-${arch}.${ext}",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Peiskos uses your microphone when you join a voice room.",
        "NSCameraUsageDescription": "Peiskos uses your camera when you turn it on in a voice room."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Chat"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Peiskos-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HaxMarris",
        "repo": "Burrow"
      }
    ]
  }
}
