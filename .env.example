# Copy this file to .env and fill it in. Burrow updates never change .env.

# Friends need this code to create an account. Pick something only they will know.
REGISTRATION_CODE=change-me

# Voice rooms. Make a secret with:  openssl rand -base64 32
# Remove these three lines if you don't want voice.
COMPOSE_PROFILES=voice
LIVEKIT_API_KEY=burrow
LIVEKIT_API_SECRET=paste-a-long-random-secret-here
