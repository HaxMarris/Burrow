# Copy this file to .env and fill it in. Peiskos updates never change .env.

# Friends need this code to create an account. Pick something only they will know.
REGISTRATION_CODE=change-me

# Voice rooms. Make a secret with:  openssl rand -base64 32
# Remove these three lines if you don't want voice.
# Add ",updates" to COMPOSE_PROFILES to install updates from the admin page (see README):
#   COMPOSE_PROFILES=voice,updates
COMPOSE_PROFILES=voice
LIVEKIT_API_KEY=burrow
LIVEKIT_API_SECRET=paste-a-long-random-secret-here

# GIF picker. Get a free key at https://partner.klipy.com (see README). Leave it out to hide the GIF button.
# KLIPY_API_KEY=paste-your-klipy-key-here
# Which GIFs show up: g, pg, pg-13 (the default) or r.
# GIF_RATING=pg-13

# Email, so people can reset a forgotten password (they confirm their address in their account).
# Any mail server works (a Gmail app password is easiest, see README): smtps://user:password@host:465, or smtp://user:password@host:587.
# SMTP_URL=smtps://you%40example.com:app-password@smtp.example.com:465
# MAIL_FROM=Peiskos <you@example.com>
# The address friends open Peiskos at, for the link in those emails.
# PUBLIC_URL=https://chat.example.com

# Peiskos only listens on this machine, for Caddy. Uncomment to reach it on port 3000
# from other machines without a reverse proxy.
# BURROW_BIND=0.0.0.0

# Who can open the admin page (your picture > Server admin): usernames, comma-separated.
# Leave it out and it's the first account made on this server.
# ADMIN_USERS=maxwell

# The privacy policy and terms (at /privacy and /terms, linked from signup) name who runs this server
# and how to reach them. The contact falls back to the MAIL_FROM address. App stores need both pages.
# LEGAL_NAME=Maxwell
# LEGAL_CONTACT=hello@example.com

# Uptime alerts: a "heartbeat" address from a monitor like healthchecks.io, pinged every five
# minutes; it emails you when the pings stop. (Or point any monitor at https://your-address/api/health.)
# HEARTBEAT_URL=https://hc-ping.com/your-check-id

# Fire decorations, fire looks and marshmallows are all unlocked for now. Set this to make them
# wait for hours at the fire again (hours are counted either way).
# FIRE_UNLOCKS=hours

# Off-site backups: each day's backup and every uploaded file are also copied to S3-style storage
# (Backblaze B2, Cloudflare R2, Amazon S3, Wasabi...). See README.
# BACKUP_S3_BUCKET=my-burrow-backups
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-west-004
# BACKUP_S3_KEY_ID=your-key-id
# BACKUP_S3_SECRET=your-secret-key
